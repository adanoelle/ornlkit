Bootstrap: docker
From: ubuntu:24.04

%labels
    Author ORNL Data Engineering
    Description Portable data engineering environment for Frontier

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        wget \
        pkg-config \
        libssl-dev \
        && rm -rf /var/lib/apt/lists/*

    # --- Python (matches OLCF miniforge3 Python version) ---
    apt-get update && apt-get install -y --no-install-recommends \
        python3.12 \
        python3.12-venv \
        python3.12-dev \
        && rm -rf /var/lib/apt/lists/*

    # --- UV (single static binary) ---
    curl -LsSf https://astral.sh/uv/install.sh | sh
    mv /root/.local/bin/uv /usr/local/bin/uv
    mv /root/.local/bin/uvx /usr/local/bin/uvx

    # --- Rust ---
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
        sh -s -- -y --default-toolchain stable --profile minimal
    . /root/.cargo/env
    cp /root/.cargo/bin/* /usr/local/bin/

    # --- MPICH 3.4.2 (required for Frontier MPI ABI compatibility) ---
    cd /tmp
    wget -q https://www.mpich.org/static/downloads/3.4.2/mpich-3.4.2.tar.gz
    tar xzf mpich-3.4.2.tar.gz
    cd mpich-3.4.2
    ./configure --prefix=/usr/local --disable-fortran
    make -j$(nproc)
    make install
    ldconfig
    cd / && rm -rf /tmp/mpich-3.4.2*

    # --- Python environment ---
    uv venv /opt/ornlkit-venv --python python3.12
    . /opt/ornlkit-venv/bin/activate
    uv pip install \
        polars \
        pyarrow \
        datafusion \
        pydantic \
        orjson \
        rustworkx \
        mpi4py

%environment
    export PATH="/opt/ornlkit-venv/bin:/usr/local/bin:$PATH"
    export VIRTUAL_ENV="/opt/ornlkit-venv"

%runscript
    exec python3 "$@"

%help
    Portable data engineering container for ORNL Frontier.

    Build:
        apptainer build frontier.sif containers/frontier.def

    Run interactively:
        apptainer shell frontier.sif

    On Frontier (with GPU + MPI support):
        module load apptainer-enable-gpu apptainer-enable-mpi
        srun -N1 -n8 apptainer exec frontier.sif python3 my_script.py
